# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/qa-artifacts/
/qa-logs/
/tmp/
qa-*.log
qa*.log

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.log
*.pid
*.apk
*.aab
*.zip
*.blend1
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# Android/Gradle generated files
/android-app/.gradle/
/android-app/**/build/
/android-app/local.properties
/android-app/.idea/

# Unity generated files not covered by the nested Unity .gitignore
/unity-jelly-gate/.utmp/
/unity-jelly-gate/outputs/
/unity-jelly-gate/tmp/
/unity-jelly-gate/work/

# Google Play upload credentials (local secure backup only)
/release-keys/
*.keystore
*.jks
